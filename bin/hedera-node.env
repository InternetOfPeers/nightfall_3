#! /bin/bash
# When these environment variables are used from script in the terminal, not inside the docker containers, remember
# the blockchain URL should be http://localhost:7546, and not something else like http://host.docker.internal:7546.
set -o allexport
ETH_PRIVATE_KEY="$2"
BLOCKCHAIN_URL=${3:-"http://localhost:7546"}
NF_SERVICES_TO_START="client,worker,optimist,rabbitmq,mongodb,mongo-express"
# If void il will default to all services defined in NF_SERVICES_TO_START
# NF_SERVICES_TO_LOG="client,worker,optimist"
NF_SERVICES_TO_LOG=""
ENVIRONMENT=hederaTestnet
USE_EXTERNAL_NODE=true
#USER1_ADDRESS=""
#USER1_KEY=""
#USER2_ADDRESS=""
#USER2_KEY=""
#BOOT_PROPOSER_ADDRESS=""
#BOOT_PROPOSER_KEY=""
PROPOSER_KEY="$2"
PROPOSER2_ADDRESS="$1"
#PROPOSER2_KEY=""
#PROPOSER3_ADDRESS=""
#PROPOSER3_KEY=""
MULTISIG_SIGNATURE_THRESHOLD=2
MULTISIG_APPROVERS="0x0000000000000000000000000000000000000001,0x0000000000000000000000000000000000000002"
#LIQUIDITY_PROVIDER_KEY=""
ERC20_COIN=USDB
FEE_L2_TOKEN_ID=WHBAR
RESTRICT_TOKENS=disable
ETH_NETWORK=hedera
DEPLOY_MOCKED_SANCTIONS_CONTRACT=true
STATE_GENESIS_BLOCK=31364756
CONFIRMATIONS=1
CHECK_REGISTER_PROPOSER_SECOND=120
TIMER_CHANGE_PROPOSER_SECOND=300
set +o allexport