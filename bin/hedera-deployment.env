#! /bin/bash
set -o allexport

# The rest of the parameters will be sate later in .env.deployment.hedera
ETH_ADDRESS=$1
ETH_PRIVATE_KEY=$2

# Context parameters not strictly related to the Hedera deployment, but useful for changing the deployer's behaviour on the fly
# NF_SERVICES_TO_START='deployer,worker'
CONFIRMATIONS=1
# Set to true to skip building the deployer docker images
NO_SERVICES_SETUP=false

set +o allexport